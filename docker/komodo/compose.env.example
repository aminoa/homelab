# Copy to compose.env and fill in the secrets (compose.env is gitignored).
# Full variable list: https://github.com/moghtech/komodo/blob/main/compose/compose.env
# No quotes around values: `docker stack deploy` passes them through literally,
# unlike `docker compose`, and Komodo Core rejects a quoted enum value.

COMPOSE_KOMODO_IMAGE_TAG=2.3.1
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

## DB credentials
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=CHANGEME

TZ=America/New_York

#=-------------------------=#
#= Komodo Core Environment =#
#=-------------------------=#

## Used for Oauth / webhook URL suggestions.
KOMODO_HOST=https://komodo.aneeshmaganti.com
KOMODO_TITLE=Komodo

KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
## Initial admin user, created on first launch only.
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=CHANGEME

## Name of the Server that Periphery auto-registers as.
KOMODO_FIRST_SERVER_NAME=Local

KOMODO_WEBHOOK_SECRET=CHANGEME
KOMODO_JWT_SECRET=CHANGEME
KOMODO_JWT_TTL=1-day

## Nobody else should be able to sign up on a homelab instance.
KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false

#=------------------------------=#
#= Komodo Periphery Environment =#
#=------------------------------=#

PERIPHERY_CORE_ADDRESS=ws://core:9120
# Literal, not ${KOMODO_FIRST_SERVER_NAME}: `docker stack deploy` does not
# interpolate variables inside an env_file the way `docker compose` does.
PERIPHERY_CONNECT_AS=Local
PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub

## Compose files / repos Komodo manages must live under this directory.
PERIPHERY_ROOT_DIRECTORY=/etc/komodo

## Keeps the reported disk size from double-counting mounts.
PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
